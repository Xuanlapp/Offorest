# Local-only MySQL mockup worker configuration. Copy this file to .env and set folders on your machine.
OFFOREST_LOCAL_MYSQL_HOST=127.0.0.1
OFFOREST_LOCAL_MYSQL_PORT=3306
OFFOREST_LOCAL_MYSQL_USER=root
OFFOREST_LOCAL_MYSQL_PASSWORD=
OFFOREST_LOCAL_MYSQL_DATABASE=xlap.tech
OFFOREST_LOCAL_STORAGE_ROOT=D:\\laragon\\www\\your-project\\storage\\app\\public
OFFOREST_LOCAL_OUTPUT_DIR=D:\\Offorest\\local-mockup-output
OFFOREST_LOCAL_MOCKUP_POLL_MS=2000
OFFOREST_LOCAL_MOCKUP_CONCURRENCY=5
